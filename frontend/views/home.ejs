<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f6f1">
    <meta name="description" content="แบ่งปันของดีที่ยังมีประโยชน์ ให้สิ่งของได้เดินทางต่อและส่งต่อความสุขในชุมชน">
    <title><%= appName %> — ส่งต่อของดีให้ถึงมือคนที่ต้องการ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/app.css">
    <script src="/assets/js/app.js" defer></script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Sharing Leftovers หน้าแรก">
        <span class="brand-mark">SL</span>
        <span>Sharing <span class="brand-light">Leftovers</span><small>SHARE WHAT MATTERS</small></span>
      </a>
      <nav class="main-nav" aria-label="เมนูหลัก">
        <a class="nav-link active" href="#discover">ค้นหาของ</a>
        <button class="nav-link" type="button" data-open-panel="my-space">พื้นที่ของฉัน</button>
        <button class="nav-link admin-link hidden" type="button" data-open-panel="admin-space">จัดการระบบ</button>
      </nav>
      <div class="nav-actions">
        <span id="user-greeting" class="user-greeting hidden"></span>
        <button id="login-open" class="button button-quiet" type="button">เข้าสู่ระบบ</button>
        <button id="register-open" class="button button-dark" type="button">เริ่มแบ่งปัน <span aria-hidden="true">↗</span></button>
        <button id="logout-button" class="button button-quiet hidden" type="button">ออกจากระบบ</button>
        <button class="menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false">☰</button>
      </div>
    </header>

    <main class="page-shell">
      <section class="hero-grid" aria-labelledby="hero-title">
        <div class="hero-main tile">
          <div class="eyebrow"><span class="eyebrow-dot"></span> ของที่ยังมีคุณค่า ควรได้ไปต่อ</div>
          <h1 id="hero-title">ของเหลือจากเรา<br><span>อาจเป็นของพอดี</span><br>สำหรับใครอีกคน</h1>
          <p class="hero-copy">พื้นที่เล็ก ๆ สำหรับแบ่งปันสิ่งของที่ยังใช้ได้ ให้คนใกล้ตัวได้พบของที่ต้องการ และช่วยกันลดของที่ต้องทิ้ง</p>
          <div class="hero-actions">
            <a class="button button-dark button-large" href="#discover">เลือกดูของที่แบ่งปัน <span aria-hidden="true">↘</span></a>
            <button class="text-action" type="button" data-open-panel="create-listing">ลงประกาศแบ่งปัน <span aria-hidden="true">↗</span></button>
          </div>
          <div class="hero-foot"><span class="avatar-stack"><i>🌱</i><i>🧡</i><i>♻️</i></span><span>เริ่มจากของชิ้นเดียว<br><strong>เปลี่ยนเป็นเรื่องดี ๆ ได้เสมอ</strong></span></div>
          <span class="hero-decoration" aria-hidden="true">↗</span>
        </div>
        <div class="hero-side">
          <article class="tile impact-tile">
            <div class="tile-topline"><span>SMALL ACT, BIG CIRCLE</span><span class="sun-icon">✳</span></div>
            <div class="impact-illustration" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="plant">♧</span><span class="spark spark-one">✦</span><span class="spark spark-two">✧</span></div>
            <h2>แบ่งปันอย่างใส่ใจ<br>โลกก็เบาขึ้นอีกนิด</h2>
            <p>ของใช้ที่ไม่จำเป็นสำหรับเรา อาจจำเป็นสำหรับใครบางคน</p>
          </article>
          <article class="tile note-tile">
            <span class="note-icon">♡</span>
            <div><strong>ส่งต่อด้วยความไว้ใจ</strong><p>คุยกัน นัดรับกัน ในแบบที่สะดวกทั้งสองฝ่าย</p></div>
            <span class="note-arrow" aria-hidden="true">↗</span>
          </article>
        </div>
      </section>

      <section class="community-strip" aria-label="แนวคิดของชุมชน">
        <span class="strip-label">ที่นี่เราเชื่อว่า</span>
        <span><i>01</i> ของทุกชิ้นมีเรื่องราว</span><span class="strip-divider"></span>
        <span><i>02</i> การให้เริ่มได้ใกล้ตัว</span><span class="strip-divider"></span>
        <span><i>03</i> ชุมชนดีขึ้นได้ด้วยกัน</span>
      </section>

      <section id="discover" class="discover-section">
        <div class="section-heading">
          <div><div class="eyebrow">THE COMMUNITY SHELF</div><h2>ชั้นวางแบ่งปัน <span id="listing-count" class="count-pill">กำลังโหลด</span></h2><p>ลองเลือกดู เผื่อมีชิ้นที่กำลังตามหาอยู่</p></div>
          <button class="button button-outline" type="button" data-open-panel="create-listing">＋ ลงประกาศของฉัน</button>
        </div>
        <form id="search-form" class="filter-bar">
          <label class="search-field"><span aria-hidden="true">⌕</span><input name="search" type="search" placeholder="ค้นหาของที่กำลังมองหา..." aria-label="ค้นหาประกาศ"></label>
          <label class="select-wrap"><span class="sr-only">หมวดหมู่</span><select name="category"><option value="">ทุกหมวดหมู่</option></select></label>
          <label class="select-wrap"><span class="sr-only">สภาพสินค้า</span><select name="condition"><option value="">ทุกสภาพ</option><option value="new">ใหม่</option><option value="like_new">เหมือนใหม่</option><option value="good">ดี</option><option value="fair">พอใช้</option><option value="poor">มีตำหนิ</option></select></label>
          <label class="select-wrap"><span class="sr-only">เรียงตาม</span><select name="sort"><option value="latest">มาใหม่</option><option value="popular">คนสนใจ</option><option value="expiring">ใกล้หมดเวลา</option><option value="oldest">ลงไว้นาน</option></select></label>
          <button class="button button-dark search-submit" type="submit">ค้นหา</button>
          <details class="location-filter"><summary title="ค้นหาตามระยะทาง">⌖</summary><div class="location-popover"><strong>ค้นหาใกล้ฉัน</strong><p>ใช้ตำแหน่งปัจจุบันเพื่อหาของในระยะที่กำหนด</p><label>ระยะทาง<select name="radius"><option value="1000">1 กม.</option><option value="5000" selected>5 กม.</option><option value="10000">10 กม.</option><option value="25000">25 กม.</option></select></label><button type="button" class="button button-outline" id="location-button">ใช้ตำแหน่งของฉัน</button><button type="button" class="text-action" id="clear-location">ล้างตำแหน่ง</button></div></details>
        </form>
        <div id="listing-grid" class="listing-grid" aria-live="polite"><div class="loading-state">กำลังตามหาของดี ๆ ให้คุณ<span class="loading-dot">...</span></div></div>
        <div class="pagination-row"><span id="page-summary"></span><div><button class="button button-outline page-button" id="prev-page" type="button" disabled>← ก่อนหน้า</button><button class="button button-outline page-button" id="next-page" type="button" disabled>ถัดไป →</button></div></div>
      </section>

      <section class="closing-banner tile">
        <div class="closing-orb" aria-hidden="true">♡</div>
        <div><div class="eyebrow">PASS IT ON</div><h2>ของที่ไม่ได้ใช้แล้ว<br>อาจมีความหมายกับใครสักคน</h2></div>
        <a class="button button-dark button-large" href="#discover">ดูของที่กำลังรอเจ้าของ</a>
      </section>
    </main>

    <footer class="site-footer"><a class="brand footer-brand" href="/"><span class="brand-mark">SL</span><span>Sharing <span class="brand-light">Leftovers</span><small>SHARE WHAT MATTERS</small></span></a><p>ส่งต่อของดี สร้างชุมชนที่ใส่ใจไปด้วยกัน</p><a href="/api-docs">เอกสาร API ↗</a><span>© <span id="year"></span> Sharing Leftovers</span></footer>
    <div id="toast-region" class="toast-region" role="status" aria-live="polite"></div>
    <div id="modal-root"></div>
    <div id="panel-root"></div>
  </body>
</html>
