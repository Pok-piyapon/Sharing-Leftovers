<%- include('partials/head', { title: 'หน้าแรก' }) %>
<%- include('partials/header') %>
<%- include('partials/flash') %>

<%
  const role = isAuthenticated ? currentUser.role : 'guest';
%>

<div class="ui container" style="padding-top: 2em; padding-bottom: 3em;">

  <!-- Hero -->
  <div style="text-align: center; max-width: 720px; margin: 0 auto 3em;">
    <div class="ui large green label" style="margin-bottom: 1em;">
      <i class="fa-solid fa-seedling"></i> ตลาดแบ่งปันของชุมชน · Zero Waste Marketplace
    </div>
    <h1 class="ui header" style="font-size: 2.4rem; color: var(--brand-green);">
      แบ่งปันสิ่งของ ส่งต่อคุณค่าให้ชุมชน <i class="fa-solid fa-leaf"></i>
    </h1>
    <p style="font-size: 1.1rem; color: rgba(0,0,0,.6);">
      ของที่คุณไม่ได้ใช้ อาจเป็นสิ่งจำเป็นของคนอื่น ร่วมส่งต่อเสื้อผ้า อาหาร หนังสือ และของใช้สภาพดีให้เพื่อนบ้านรอบตัว
    </p>

    <form action="/listings" method="GET" class="ui action input fluid" style="max-width: 560px; margin: 1.5em auto 0;">
      <input type="text" name="search" placeholder="พิมพ์ชื่อสิ่งของที่ต้องการ เช่น เสื้อผ้า, โต๊ะเขียนหนังสือ...">
      <button type="submit" class="ui green button"><i class="fa-solid fa-magnifying-glass"></i> ค้นหา</button>
    </form>

    <div style="margin-top: 1em;">
      <button type="button" id="near-me-home-btn" class="ui basic green button"><i class="fa-solid fa-location-dot"></i> ค้นหาของใกล้ฉัน</button>
    </div>

    <% if (categories.length > 0) { %>
      <div style="margin-top: 1.5em; display:flex; flex-wrap:wrap; justify-content:center; gap: 0.5em;">
        <% categories.forEach(function (c) { %>
          <a href="/listings?category=<%= c.slug %>" class="ui label"><%= c.icon %> <%= c.name %></a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="ui divider"></div>

  <!-- สิ่งของที่เพิ่งแบ่งปัน -->
  <div style="margin-bottom: 3em;">
    <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom: 1em;">
      <h2 class="ui header" style="color: var(--brand-green);"><i class="fa-solid fa-sparkles"></i> สิ่งของที่เพิ่งแบ่งปัน</h2>
      <a href="/listings">ดูทั้งหมด <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <% if (recentListings.length === 0) { %>
      <%- include('partials/empty-state', {
        emptyIcon: 'fa-box',
        emptyTitle: 'ยังไม่มีประกาศในระบบ',
        emptyDesc: 'เป็นคนแรกที่เริ่มแบ่งปันสิ่งของให้ชุมชนกันเถอะ',
        emptyActionText: role === 'guest' ? 'เข้าสู่ระบบเพื่อเริ่มแบ่งปัน' : 'เริ่มแบ่งปัน',
        emptyActionUrl: role === 'guest' ? '/auth' : '/listings/new'
      }) %>
    <% } else { %>
      <div class="ui four stackable cards">
        <% recentListings.forEach(function (listing) { %>
          <%- include('partials/listing-card', { listing }) %>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- วิธีใช้งาน 3 ขั้นตอน -->
  <div style="margin-bottom: 3em;">
    <h2 class="ui header" style="text-align:center; color: var(--brand-green);">ใช้งานง่ายใน 3 ขั้นตอน</h2>
    <div class="ui stackable three column grid">
      <div class="column">
        <div class="ui segment" style="text-align:center;">
          <i class="fa-solid fa-camera" style="font-size:2rem; color: var(--brand-green);"></i>
          <h3 class="ui header">1. ลงประกาศ</h3>
          <p style="color: rgba(0,0,0,.6);">ถ่ายรูปของที่ไม่ได้ใช้แล้ว แล้วลงประกาศแบ่งปัน</p>
        </div>
      </div>
      <div class="column">
        <div class="ui segment" style="text-align:center;">
          <i class="fa-solid fa-handshake" style="font-size:2rem; color: var(--brand-green);"></i>
          <h3 class="ui header">2. รับคำขอ</h3>
          <p style="color: rgba(0,0,0,.6);">ผู้ที่สนใจจะส่งคำขอมา คุณเลือกอนุมัติคนที่เหมาะสม</p>
        </div>
      </div>
      <div class="column">
        <div class="ui segment" style="text-align:center;">
          <i class="fa-solid fa-box-open" style="font-size:2rem; color: var(--brand-green);"></i>
          <h3 class="ui header">3. นัดรับของ</h3>
          <p style="color: rgba(0,0,0,.6);">นัดเวลาและสถานที่รับของด้วยตนเอง ง่ายและปลอดภัย</p>
        </div>
      </div>
    </div>
    <p style="text-align:center; margin-top: 1em;">
      <a href="/help/how-it-works">อ่านรายละเอียดเพิ่มเติม <i class="fa-solid fa-arrow-right"></i></a>
    </p>
  </div>

  <!-- CTA ตาม role -->
  <% if (role !== 'admin') { %>
    <div class="ui green segment" style="text-align:center; padding: 3em 1em;">
      <h2 class="ui header">มีของที่ไม่ได้ใช้แล้วใช่ไหม?</h2>
      <p>ส่งต่อให้คนที่ต้องการ แทนการทิ้งไปเฉยๆ</p>
      <% if (role === 'guest') { %>
        <a href="/auth" class="ui big green button">เข้าสู่ระบบเพื่อเริ่มแบ่งปัน</a>
      <% } else { %>
        <a href="/listings/new" class="ui big green button"><i class="fa-solid fa-plus"></i> เริ่มแบ่งปันเลย</a>
      <% } %>
    </div>
  <% } %>

</div>

<script>
  document.getElementById('near-me-home-btn').addEventListener('click', function () {
    if (!navigator.geolocation) { window.location.href = '/listings'; return; }
    navigator.geolocation.getCurrentPosition(function (pos) {
      window.location.href = '/listings?lat=' + pos.coords.latitude + '&lng=' + pos.coords.longitude;
    }, function () {
      window.location.href = '/listings';
    });
  });
</script>

<%- include('partials/footer') %>
