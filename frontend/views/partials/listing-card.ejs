<%
  const item = typeof listing !== 'undefined' ? listing : {};
  const id = item._id || '#';
  const title = item.title || 'ไม่มีชื่อสิ่งของ';
  const imgUrl = (item.images && item.images.length > 0) ? item.images[0] : 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=500&auto=format&fit=crop&q=60';
  const status = item.status || 'available';
  const categoryName = (item.category && item.category.name) ? item.category.name : (typeof item.categoryName !== 'undefined' ? item.categoryName : 'ของใช้ทั่วไป');
  const categoryIcon = (item.category && item.category.icon) ? item.category.icon : '📦';

  const statusConfig = {
    available: { text: 'พร้อมรับ', color: 'green' },
    reserved: { text: 'จองเต็มแล้ว', color: 'orange' },
    completed: { text: 'ส่งมอบแล้ว', color: 'grey' },
    cancelled: { text: 'ยกเลิกแล้ว', color: 'red' },
    expired: { text: 'หมดอายุ', color: 'black' }
  };
  const statusInfo = statusConfig[status] || { text: status, color: 'green' };

  const conditionMap = { new: 'ใหม่', like_new: 'เหมือนใหม่', good: 'ดี', fair: 'พอใช้', poor: 'มีตำหนิ' };
  const conditionText = conditionMap[item.condition] || item.condition || 'ดี';

  const available = typeof item.availableQuantity !== 'undefined' ? item.availableQuantity : 1;
  const total = typeof item.quantity !== 'undefined' ? item.quantity : 1;
  const area = (item.pickup && item.pickup.area)
    ? `${item.pickup.area.subdistrict || ''} ${item.pickup.area.district || ''} ${item.pickup.area.province || ''}`.trim()
    : (item.areaText || 'พื้นที่รอบมหาวิทยาลัย');

  let timeLeftText = '';
  if (item.expiresAt) {
    const msLeft = new Date(item.expiresAt).getTime() - Date.now();
    const daysLeft = Math.ceil(msLeft / (1000 * 60 * 60 * 24));
    timeLeftText = daysLeft > 0 ? `เหลือ ${daysLeft} วัน` : 'หมดอายุแล้ว';
  }
%>
<div class="ui card">
  <a href="/listings/<%= id %>" class="image" style="position:relative; aspect-ratio: 4/3; overflow:hidden; display:block;">
    <img src="<%= imgUrl %>" alt="<%= title %>" loading="lazy" style="width:100%; height:100%; object-fit:cover;"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=500&auto=format&fit=crop&q=60';">
    <div class="ui <%= statusInfo.color %> label" style="position:absolute; top:0.6em; left:0.6em;"><%= statusInfo.text %></div>
  </a>
  <div class="content">
    <div class="meta">
      <span><%= categoryIcon %> <%= categoryName %></span>
      &nbsp;·&nbsp;
      <span>สภาพ: <%= conditionText %></span>
    </div>
    <a href="/listings/<%= id %>" class="header" style="font-size: 1.05em; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;" title="<%= title %>"><%= title %></a>
    <div class="description">
      <i class="fa-solid fa-boxes-stacked"></i> เหลือ <%= available %> จาก <%= total %> ชิ้น
    </div>
  </div>
  <div class="extra content">
    <span><i class="fa-solid fa-location-dot"></i> <%= area %></span>
    <% if (timeLeftText) { %><span class="right floated"><i class="fa-regular fa-clock"></i> <%= timeLeftText %></span><% } %>
  </div>
</div>
