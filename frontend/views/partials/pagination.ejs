<%
  const current = typeof currentPage !== 'undefined' ? Number(currentPage) : 1;
  const total = typeof totalPages !== 'undefined' ? Number(totalPages) : 1;
  const base = typeof basePath !== 'undefined' ? basePath : '?page=';

  if (total > 1) {
%>
<div class="ui pagination menu" aria-label="การเปลี่ยนหน้าผลลัพธ์" style="flex-wrap:wrap;">
  <a href="<%= current > 1 ? base + (current - 1) : '#' %>" class="icon item <%= current <= 1 ? 'disabled' : '' %>" aria-label="หน้าก่อนหน้า">
    <i class="fa-solid fa-angle-left"></i>
  </a>
  <% for (let i = 1; i <= total; i++) { %>
    <a href="<%= base + i %>" class="item <%= i === current ? 'active' : '' %>" aria-current="<%= i === current ? 'page' : 'false' %>"><%= i %></a>
  <% } %>
  <a href="<%= current < total ? base + (current + 1) : '#' %>" class="icon item <%= current >= total ? 'disabled' : '' %>" aria-label="หน้าถัดไป">
    <i class="fa-solid fa-angle-right"></i>
  </a>
</div>
<% } %>
