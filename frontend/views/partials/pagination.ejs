<%
  const current = typeof currentPage !== 'undefined' ? Number(currentPage) : 1;
  const total = typeof totalPages !== 'undefined' ? Number(totalPages) : 1;
  const base = typeof basePath !== 'undefined' ? basePath : '?page=';

  if (total > 1) {
%>
<nav aria-label="การเปลี่ยนหน้าผลลัพธ์">
  <ul class="pagination">
    <!-- ปุ่มย้อนกลับ -->
    <li>
      <a 
        href="<%= current > 1 ? base + (current - 1) : '#' %>" 
        class="page-link <%= current <= 1 ? 'disabled' : '' %>"
        aria-label="หน้าก่อนหน้า"
      >
        &laquo;
      </a>
    </li>

    <!-- หมายเลขหน้า -->
    <% for (let i = 1; i <= total; i++) { %>
      <li>
        <a 
          href="<%= base + i %>" 
          class="page-link <%= i === current ? 'active' : '' %>"
          aria-current="<%= i === current ? 'page' : 'false' %>"
        >
          <%= i %>
        </a>
      </li>
    <% } %>

    <!-- ปุ่มถัดไป -->
    <li>
      <a 
        href="<%= current < total ? base + (current + 1) : '#' %>" 
        class="page-link <%= current >= total ? 'disabled' : '' %>"
        aria-label="หน้าถัดไป"
      >
        &raquo;
      </a>
    </li>
  </ul>
</nav>
<% } %>
