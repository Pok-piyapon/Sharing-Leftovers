<% const role = isAuthenticated ? currentUser.role : 'guest'; %>

<% if (role === 'admin') { %>
  <div class="ui yellow inverted segment" style="margin:0; border-radius:0; text-align:center; padding: 0.5em;">
    <i class="fa-solid fa-shield-halved"></i> คุณกำลังอยู่ในโหมดผู้ดูแลระบบ (Back-office Mode) — ตรวจตราและกำกับดูแลประกาศ
  </div>
<% } %>

<div class="ui stackable menu app-header" style="border-radius:0; margin-bottom:0;">
  <div class="ui container">
    <a href="/" class="header item">
      <i class="fa-solid fa-leaf"></i>&nbsp;Sharing Leftovers
    </a>
    <a href="/listings" class="item"><i class="fa-solid fa-magnifying-glass"></i>&nbsp;ค้นหาสิ่งของ</a>
    <a href="/help/how-it-works" class="item"><i class="fa-solid fa-book-open"></i>&nbsp;วิธีใช้งาน</a>

    <div class="right menu">
      <% if (role === 'guest') { %>
        <a href="/auth" class="item">เข้าสู่ระบบ</a>
        <div class="item">
          <a href="/auth?tab=register" class="ui green button">สมัครสมาชิก</a>
        </div>
      <% } else if (role === 'admin') { %>
        <a href="/admin" class="item"><i class="fa-solid fa-gear"></i>&nbsp;จัดการระบบ</a>
        <div class="item">
          <form method="POST" action="/auth/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="ui basic inverted button">ออกจากระบบ</button>
          </form>
        </div>
      <% } else { %>
        <div class="item">
          <a href="/listings/new" class="ui green button"><i class="fa-solid fa-plus"></i>&nbsp;เริ่มแบ่งปัน</a>
        </div>
        <a href="/reservations/my" class="item">
          <i class="fa-solid fa-box"></i>&nbsp;คำขอของฉัน
          <% if (unreadCount > 0) { %><div class="floating ui red label" id="unread-badge"><%= unreadCount %></div><% } %>
        </a>
        <a href="/dashboard" class="item"><i class="fa-solid fa-user"></i>&nbsp;<%= currentUser.name %></a>
        <div class="item">
          <form method="POST" action="/auth/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="ui basic inverted button">ออกจากระบบ</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>
