<%- include('../../partials/head', { title: 'เปลี่ยนรหัสผ่าน' }) %>
<%- include('../../partials/header') %>
<%- include('../../partials/flash') %>

<div class="ui container" style="max-width: 440px !important; padding-top: 2em; padding-bottom: 3em;">
  <h1 class="ui header" style="color: var(--brand-green);"><i class="fa-solid fa-lock"></i> เปลี่ยนรหัสผ่าน</h1>

  <form id="password-form" class="ui form segment">
    <div class="field">
      <label>รหัสผ่านปัจจุบัน <span style="color:var(--brand-terracotta);">*</span></label>
      <input type="password" id="pw-current" required autocomplete="current-password">
    </div>
    <div class="field">
      <label>รหัสผ่านใหม่ (อย่างน้อย 8 ตัวอักษร) <span style="color:var(--brand-terracotta);">*</span></label>
      <input type="password" id="pw-new" minlength="8" required autocomplete="new-password">
      <div id="password-strength" style="font-size:0.85em; margin-top:0.3em;"></div>
    </div>
    <div class="field">
      <label>ยืนยันรหัสผ่านใหม่ <span style="color:var(--brand-terracotta);">*</span></label>
      <input type="password" id="pw-confirm" minlength="8" required autocomplete="new-password">
    </div>
    <button type="submit" class="ui fluid green button">เปลี่ยนรหัสผ่าน</button>
  </form>
</div>

<script src="/assets/js/pages/change-password.js" defer></script>

<%- include('../../partials/footer') %>
