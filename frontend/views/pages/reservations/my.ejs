<%- include('../../partials/head', { title: 'คำขอของฉัน' }) %>
<%- include('../../partials/header') %>
<%- include('../../partials/flash') %>

<%
  const STATUS_INFO = {
    pending: { text: 'รอเจ้าของพิจารณา', color: 'yellow' },
    approved: { text: 'อนุมัติแล้ว', color: 'green' },
    rejected: { text: 'ไม่ได้รับอนุมัติ', color: 'red' },
    cancelled: { text: 'ยกเลิกแล้ว', color: 'grey' },
    completed: { text: 'ส่งมอบสำเร็จ', color: 'grey' }
  };
  const FILTERS = [
    { value: '', label: 'ทั้งหมด' },
    { value: 'pending', label: 'รอพิจารณา' },
    { value: 'approved', label: 'อนุมัติแล้ว' },
    { value: 'completed', label: 'สำเร็จแล้ว' },
    { value: 'rejected', label: 'ไม่อนุมัติ' },
    { value: 'cancelled', label: 'ยกเลิกแล้ว' }
  ];
%>

<div class="ui container" style="padding-top: 1.5em; padding-bottom: 3em;">
  <h1 class="ui header" style="color: var(--brand-green);"><i class="fa-solid fa-box"></i> คำขอของฉัน</h1>

  <div style="margin-bottom: 1.5em;">
    <% FILTERS.forEach(function (f) { %>
      <a href="/reservations/my<%= f.value ? '?status=' + f.value : '' %>" class="ui <%= status === f.value ? 'green' : '' %> label"><%= f.label %></a>
    <% }) %>
  </div>

  <% if (reservations.length === 0) { %>
    <%- include('../../partials/empty-state', {
      emptyIcon: 'fa-box',
      emptyTitle: 'ยังไม่มีคำขอในหมวดนี้',
      emptyDesc: 'ไปค้นหาสิ่งของที่น่าสนใจและส่งคำขอรับของกันเลย',
      emptyActionText: 'ค้นหาสิ่งของ',
      emptyActionUrl: '/listings'
    }) %>
  <% } else { %>
    <% reservations.forEach(function (r) { %>
      <% const listing = r.listing || {}; const info = STATUS_INFO[r.status] || { text: r.status, color: 'yellow' }; %>
      <div class="ui segment">
        <div style="display:flex; gap: 1em; flex-wrap: wrap;">
          <img src="<%= (listing.images && listing.images[0]) || 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=200' %>" alt="" style="width:88px; height:88px; object-fit:cover; border-radius:4px; flex-shrink:0;" onerror="this.style.display='none';">
          <div style="flex:1; min-width: 200px;">
            <div style="display:flex; justify-content: space-between; gap: 0.5em; flex-wrap: wrap;">
              <a href="/listings/<%= listing._id %>" style="font-weight:600;"><%= listing.title || 'ประกาศนี้ถูกลบไปแล้ว' %></a>
              <div class="ui <%= info.color %> label"><%= info.text %></div>
            </div>
            <p style="color: rgba(0,0,0,.5); margin: 0.3em 0;">
              จำนวน <%= r.quantity %> ชิ้น · ส่งคำขอเมื่อ <%= new Date(r.createdAt).toLocaleDateString('th-TH') %>
            </p>
            <% if (r.message) { %><p><i class="fa-regular fa-comment"></i> <%= r.message %></p><% } %>

            <% if (r.status === 'approved' || r.status === 'completed') { %>
              <div class="ui info message">
                <i class="fa-solid fa-location-dot"></i> ที่อยู่นัดรับ: <%= (listing.pickup && listing.pickup.address) || 'ไม่ระบุ' %><br>
                <% if (listing.owner && listing.owner.phone) { %><i class="fa-solid fa-phone"></i> เบอร์ติดต่อเจ้าของ: <%= listing.owner.phone %><% } %>
              </div>
            <% } else if (r.status === 'rejected') { %>
              <p style="color: var(--brand-terracotta);">เจ้าของไม่อนุมัติคำขอนี้</p>
            <% } else if (r.status === 'cancelled') { %>
              <p style="color: rgba(0,0,0,.5);">คำขอนี้ถูกยกเลิก</p>
            <% } %>

            <% if (['pending','approved'].includes(r.status)) { %>
              <button type="button" class="ui basic small button" style="margin-top: 0.5em;" data-cancel-reservation="<%= r._id %>">ยกเลิกคำขอนี้</button>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
    <%- include('../../partials/pagination', { currentPage, totalPages, basePath }) %>
  <% } %>
</div>

<script src="/assets/js/pages/reservations-my.js" defer></script>

<%- include('../../partials/footer') %>
